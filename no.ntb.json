{
  "version": 1,
  "name": "no.ntb",
  "documents": [
    {
      "name": "Article",
      "description": "Extensions for article documents.",
      "match": {"type": {"const":"core/article"}},
      "meta": [
        {"ref": "ntb://hast"}
      ]
    },
    {
      "name": "Editorial info",
      "description": "Extensions for editorial info documents.",
      "match": {"type": {"const":"core/editorial-info"}},
      "meta": [
        {"ref": "ntb://hast"}
      ]
    }
  ],
  "meta": [
    {
      "id": "ntb://hast",
      "block": {
        "name": "Hast",
        "description": "Mark documents to be sent as 'hast'",
        "declares": {"type": "ntb/hast"},
        "attributes": {
          "value": {
            "format": "int",
            "description": "Published version (usable ID) that should be sent as a 'hast'"
          }
        }
      }
    }
  ]
}
